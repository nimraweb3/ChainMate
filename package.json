{
  "name": "chainmate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write apps packages docs",
    "contracts:test": "node scripts/foundry.mjs forge test --root packages/contracts",
    "chain": "node scripts/foundry.mjs anvil --host 127.0.0.1",
    "contracts:deploy": "tsx scripts/deploy.ts",
    "assets": "node scripts/assets.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@tanstack/react-query": "^5.108.4",
    "chess.js": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.78.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.4",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "viem": "^2.58.6",
    "wagmi": "^3.7.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@foundry-rs/anvil": "^1.7.1",
    "@foundry-rs/forge": "^1.7.1",
    "@playwright/test": "^1.65.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "solc": "^0.8.39",
    "stockfish": "^19.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
