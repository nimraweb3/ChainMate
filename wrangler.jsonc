{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chainmate",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "chainmate-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "apps/worker/migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "chainmate-media-local" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }, { "name": "LOBBY", "class_name": "Lobby" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }],
  "vars": { "ENVIRONMENT": "local", "CHAIN_ID": "31337", "RPC_URL": "http://127.0.0.1:8545", "MAINNET_FINANCIAL_ENABLED": "false" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
