PORT=3001
ORIGIN=http://localhost:5173
# Leave unset for embedded, persistent PostgreSQL (PGlite).
# DATABASE_URL=postgresql://chainmate:chainmate@localhost:5432/chainmate
DATA_DIR=.data/postgres
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Generated locally by pnpm contracts:deploy. Never put the signer key in VITE_*.
ESCROW_ADDRESS=
TOKEN_ADDRESS=
RESULT_SIGNER_KEY=
# Optional public WalletConnect project ID. Restrict its allowed origins in the provider console.
VITE_WALLETCONNECT_PROJECT_ID=
